# Copy to .env (gitignored) and fill in.

# Required by SEC EDGAR fair-access policy: "Name contact@email". The client refuses to start without it.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Only needed for --live model runs. Cold runs replay recorded responses and need no key.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5 if unset. Do not use deprecated ids (claude-sonnet-5 errors).
ANTHROPIC_MODEL=claude-sonnet-5-5
